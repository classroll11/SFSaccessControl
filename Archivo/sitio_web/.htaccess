<IfModule mod_rewrite.c>
    RewriteEngine On

    # Servir directamente si el archivo o carpeta existe físicamente (assets, api, docs, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirigir todas las demás peticiones al Front Controller (index.php)
    RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>

# Deshabilitar listado de directorios
Options -Indexes
